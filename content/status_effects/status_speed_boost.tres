[gd_resource type="Resource" script_class="StatusEffectData" load_steps=4 format=3]

[ext_resource type="Script" path="res://core/data/items/status_effect_data.gd" id="1_data"]
[ext_resource type="Script" path="res://core/data/upgrades/effects/stat_effect_data.gd" id="2_stat"]

[sub_resource type="Resource" id="3_speed"]
script = ExtResource("2_stat")
stat = &"move_speed"
add = 0.0
multiply = 1.5

[resource]
script = ExtResource("1_data")
id = &"status_speed_boost"
display_name = "Speed boost"
description = "Move 50% faster for 6 seconds (energy drink, hot coffee)."
duration = 6.0
stat_modifiers = Array[ExtResource("2_stat")]([SubResource("3_speed")])
refresh_on_reapply = true
