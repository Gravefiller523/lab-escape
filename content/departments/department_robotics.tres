[resource]
script = ExtResource("1_data")
id = &"department_robotics"
display_name = "Robotics"
description = "Industrial grey, safety yellow, cold strip lights. Robot assembly, test bays and server rooms. Built first (floor generation step 4a). Its own enemies, loot and vendor stock since roadmap WP11 (roomba, turret, drone, flock camera). Its boss is Robobrain (roadmap WP13), so its boss floors are on."
tags = PackedStringArray("robotics")
room_ids = Array[StringName]([&"room_tile_robotics_welcome_center", &"room_tile_robotics_assembly_floor", &"room_tile_robotics_test_bay", &"room_tile_robotics_server_room", &"room_tile_robotics_machine_shop", &"room_tile_robotics_parts_storage", &"room_tile_robotics_charging_bay", &"room_tile_robotics_electronics_lab"])
enemy_spawns = Array[ExtResource("2_weighted")]([SubResource("Enemy_roomba"), SubResource("Enemy_turret"), SubResource("Enemy_drone"), SubResource("Enemy_flock_camera")])
boss_id = &"boss_robobrain"
loot_id = &"loot_robotics_small"
stock_id = &"stock_robotics_vending"
upgrade_type = &"cybernetic"
required_room_kinds = PackedStringArray("lift", "assembly_floor", "robot_test_bay", "server_room")
ambient_color = Color(0.55, 0.58, 0.62, 1)
accent_color = Color(0.95, 0.78, 0.12, 1)
boss_floors = true
welcome_center_scene = ExtResource("10_welcome")
room_types = Array[ExtResource("3_room_type")]([SubResource("Type_assembly_floor"), SubResource("Type_robot_test_bay"), SubResource("Type_server_room"), SubResource("Type_machine_shop"), SubResource("Type_parts_storage"), SubResource("Type_charging_bay"), SubResource("Type_electronics_lab")])
palette = {
"art": ExtResource("11_art"),
"accent": ExtResource("9_accent"),
"floor": ExtResource("7_floor"),
"trim": ExtResource("8_trim"),
"wall": ExtResource("6_wall")
}
lighting = SubResource("Lighting")
prop_pool = Array[ExtResource("2_weighted")]([SubResource("Prop_crate"), SubResource("Prop_crate_heavy"), SubResource("Prop_trash_bag")])
hazard_kinds = PackedStringArray("sparks", "fire", "malfunction")
incidents = Array[ExtResource("4_incident")]([SubResource("Incident_fabrication_fire"), SubResource("Incident_test_bay_malfunction"), SubResource("Incident_server_overload")])
