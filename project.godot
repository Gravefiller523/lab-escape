; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Lab Escape"
run/main_scene="res://systems/ui/main_menu_background.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[audio]

driver/enable_input=true

[autoload]

Config="*res://core/autoload/config.gd"
EventBus="*res://core/autoload/event_bus.gd"
ContentRegistry="*res://core/autoload/content_registry.gd"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"
SteamSession="*res://systems/steam_session/steam_session.gd"
Net="*res://systems/net_core/net.gd"
UI="*res://systems/ui/ui.gd"
Voice="*res://systems/voice/voice.gd"
Interaction="*res://systems/interaction/interaction.gd"
Props="*res://systems/physics_props/props.gd"
DebugConsole="*res://systems/debug_console/debug_console.gd"
GameFlow="*res://systems/game_flow/game_flow.gd"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/unsafe_call_argument=1

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_ai/plugin.cfg", "res://addons/godotsteam/plugin.cfg", "res://addons/gut/plugin.cfg")

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="players"
3d_physics/layer_3="enemies"
3d_physics/layer_4="props"
3d_physics/layer_5="held_props"
3d_physics/layer_6="carts"
3d_physics/layer_7="triggers"
3d_physics/layer_8="interactables"
3d_physics/layer_9="hitboxes"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

rendering_device/driver.windows="d3d12"

[steam]

initialization/app_data/app_id=480
initialization/processes/initialize_on_startup.template=true
