[resource]
script = ExtResource("1_data")
id = &"department_zoology"
display_name = "Zoology"
description = "Warm natural tones (wood, sand, moss green) and warm light. Animal holding, vet surgery, tanks and habitats (floor generation step 5b). Its boss is the giant rat."
tags = PackedStringArray("zoology")
room_ids = Array[StringName]([&"room_tile_zoology_welcome_center", &"room_tile_zoology_animal_holding", &"room_tile_zoology_vet_surgery", &"room_tile_zoology_feed_storage", &"room_tile_zoology_observation_room", &"room_tile_zoology_aquarium", &"room_tile_zoology_habitat_sim", &"room_tile_zoology_quarantine_pens"])
enemy_spawns = Array[ExtResource("2_weighted")]([SubResource("Enemy_rat"), SubResource("Enemy_bat"), SubResource("Enemy_fly"), SubResource("Enemy_kangaroo")])
boss_id = &"boss_giant_rat"
loot_id = &"loot_zoology_small"
stock_id = &"stock_zoology_vending"
upgrade_type = &"mutation"
required_room_kinds = PackedStringArray("lift", "animal_holding", "vet_surgery", "feed_storage")
ambient_color = Color(0.65, 0.6, 0.5, 1)
accent_color = Color(0.45, 0.6, 0.3, 1)
boss_floors = true
welcome_center_scene = ExtResource("10_welcome")
room_types = Array[ExtResource("3_room_type")]([SubResource("Type_animal_holding"), SubResource("Type_vet_surgery"), SubResource("Type_feed_storage"), SubResource("Type_observation_room"), SubResource("Type_aquarium"), SubResource("Type_habitat_sim"), SubResource("Type_quarantine_pens")])
palette = {
"accent": ExtResource("9_accent"),
"floor": ExtResource("7_floor"),
"trim": ExtResource("8_trim"),
"wall": ExtResource("6_wall")
}
lighting = SubResource("Lighting")
prop_pool = Array[ExtResource("2_weighted")]([SubResource("Prop_crate"), SubResource("Prop_meat"), SubResource("Prop_feed_sack"), SubResource("Prop_hay")])
hazard_kinds = PackedStringArray("broken_enclosure", "water")
incidents = Array[ExtResource("4_incident")]([SubResource("Incident_enclosure_breakout"), SubResource("Incident_tank_rupture")])
