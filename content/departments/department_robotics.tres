[gd_resource type="Resource" script_class="DepartmentData" load_steps=30 format=3]

[ext_resource type="Script" path="res://core/data/levels/department_data.gd" id="1_data"]
[ext_resource type="Script" path="res://core/data/shared/weighted_id_data.gd" id="2_weighted"]
[ext_resource type="Script" path="res://core/data/levels/room_type_data.gd" id="3_room_type"]
[ext_resource type="Script" path="res://core/data/levels/incident_data.gd" id="4_incident"]
[ext_resource type="Script" path="res://core/data/levels/lighting_style_data.gd" id="5_lighting"]
[ext_resource type="Material" path="res://assets/materials/robotics/robotics_wall.tres" id="6_wall"]
[ext_resource type="Material" path="res://assets/materials/robotics/robotics_floor.tres" id="7_floor"]
[ext_resource type="Material" path="res://assets/materials/robotics/robotics_trim.tres" id="8_trim"]
[ext_resource type="Material" path="res://assets/materials/robotics/robotics_accent.tres" id="9_accent"]
[ext_resource type="PackedScene" path="res://systems/level_gen/tiles/tile_robotics_welcome_center.tscn" id="10_welcome"]

[sub_resource type="Resource" id="Enemy_rat"]
script = ExtResource("2_weighted")
content_id = &"enemy_rat"
weight = 3.0

[sub_resource type="Resource" id="Enemy_bat"]
script = ExtResource("2_weighted")
content_id = &"enemy_bat"
weight = 1.0

[sub_resource type="Resource" id="Prop_crate"]
script = ExtResource("2_weighted")
content_id = &"prop_crate"
weight = 3.0

[sub_resource type="Resource" id="Prop_crate_heavy"]
script = ExtResource("2_weighted")
content_id = &"prop_crate_heavy"
weight = 1.0

[sub_resource type="Resource" id="Type_assembly_floor"]
script = ExtResource("3_room_type")
id = &"room_type_assembly_floor"
room_kind = &"assembly_floor"
display_name = "Assembly Floor"
max_per_floor = 1
size_categories = PackedStringArray("large")
part_categories = PackedStringArray("mechanical", "structural")

[sub_resource type="Resource" id="Type_robot_test_bay"]
