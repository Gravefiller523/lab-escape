part_categories = PackedStringArray("mechanical")

[sub_resource type="Resource" id="Type_parts_storage"]
script = ExtResource("3_room_type")
id = &"room_type_parts_storage"
room_kind = &"parts_storage"
display_name = "Parts Storage"
