[gd_resource type="Resource" script_class="BossData" load_steps=6 format=3]

[ext_resource type="Script" path="res://core/data/enemies/boss_data.gd" id="1_data"]
[ext_resource type="Script" path="res://core/data/enemies/boss_phase_data.gd" id="2_phase"]
[ext_resource type="PackedScene" path="res://systems/bosses/scenes/mushroom_man.tscn" id="3_scene"]

[sub_resource type="Resource" id="Phase_1"]
script = ExtResource("2_phase")
starts_at_health_fraction = 1.0
attack_names = PackedStringArray("spore_slam", "spore_volley")
minion_enemy_ids = Array[StringName]([&"enemy_mushroom_zombie"])
minions_per_wave = 2

[sub_resource type="Resource" id="Phase_2"]
script = ExtResource("2_phase")
starts_at_health_fraction = 0.6
attack_names = PackedStringArray("spore_slam", "spore_volley", "spore_ring")
minion_enemy_ids = Array[StringName]([&"enemy_mushroom_zombie"])
minions_per_wave = 3
minion_wave_interval = 16.0

[sub_resource type="Resource" id="Phase_3"]
script = ExtResource("2_phase")
starts_at_health_fraction = 0.25
attack_names = PackedStringArray("spore_slam", "spore_volley_fast", "spore_ring")
minion_enemy_ids = Array[StringName]([&"enemy_mushroom_zombie"])
minions_per_wave = 3
minion_wave_interval = 12.0

[resource]
script = ExtResource("1_data")
id = &"boss_mushroom_man"
display_name = "Mushroom Man"
description = "Botany's boss. Slow and tough. Lobs fans of spores, slams the ground in a spore cloud, and wakes mushroom zombies. At 60% health it adds a ring of spores in every direction; at 25% it lobs faster. Roadmap WP13."
tags = PackedStringArray("botany")
scene = ExtResource("3_scene")
max_health = 700.0
phases = Array[ExtResource("2_phase")]([SubResource("Phase_1"), SubResource("Phase_2"), SubResource("Phase_3")])
arena_room_id = &"room_arena_grey"
loot_id = &"loot_boss_mushroom_man"
impact_mass = 350.0
