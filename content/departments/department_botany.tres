[resource]
script = ExtResource("1_data")
id = &"department_botany"
display_name = "Botany"
description = "Clinical white with green accents and bright flat light. Greenhouses, seed vault, decontamination, labs (floor generation step 5a). Its own enemies, loot and vendor stock since roadmap WP10 (mushroom zombie, flytrap, spore shooter, vine creeper). Its boss is the Mushroom Man (roadmap WP13), so its boss floors are on."
tags = PackedStringArray("botany")
room_ids = Array[StringName]([&"room_tile_botany_welcome_center", &"room_tile_botany_greenhouse", &"room_tile_botany_seed_vault", &"room_tile_botany_decon_airlock", &"room_tile_botany_cell_culture_lab", &"room_tile_botany_microscopy_lab", &"room_tile_botany_soil_prep", &"room_tile_botany_autoclave_room", &"room_tile_botany_growth_chamber", &"room_tile_botany_pump_room"])
enemy_spawns = Array[ExtResource("2_weighted")]([SubResource("Enemy_mushroom_zombie"), SubResource("Enemy_flytrap"), SubResource("Enemy_spore_shooter"), SubResource("Enemy_vine_creeper")])
boss_id = &"boss_mushroom_man"
loot_id = &"loot_botany_small"
stock_id = &"stock_botany_vending"
upgrade_type = &"mutation"
required_room_kinds = PackedStringArray("lift", "greenhouse", "seed_vault", "decon_airlock")
ambient_color = Color(0.85, 0.9, 0.86, 1)
accent_color = Color(0.3, 0.8, 0.4, 1)
boss_floors = true
welcome_center_scene = ExtResource("10_welcome")
room_types = Array[ExtResource("3_room_type")]([SubResource("Type_greenhouse"), SubResource("Type_seed_vault"), SubResource("Type_decon_airlock"), SubResource("Type_cell_culture_lab"), SubResource("Type_microscopy_lab"), SubResource("Type_soil_prep"), SubResource("Type_autoclave_room"), SubResource("Type_growth_chamber"), SubResource("Type_pump_room")])
palette = {
"art": ExtResource("11_art"),
"accent": ExtResource("9_accent"),
"floor": ExtResource("7_floor"),
"trim": ExtResource("8_trim"),
"wall": ExtResource("6_wall")
}
lighting = SubResource("Lighting")
prop_pool = Array[ExtResource("2_weighted")]([SubResource("Prop_crate"), SubResource("Prop_crate_heavy"), SubResource("Prop_dna_vial")])
hazard_kinds = PackedStringArray("toxic_spores", "toxic_gas", "water")
incidents = Array[ExtResource("4_incident")]([SubResource("Incident_overgrowth_breach"), SubResource("Incident_spore_release"), SubResource("Incident_irrigation_flood"), SubResource("Incident_vault_cooling_failure")])
