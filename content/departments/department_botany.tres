[resource]
script = ExtResource("1_data")
id = &"department_botany"
display_name = "Botany"
description = "Greenhouses, seed vault, labs. PLACEHOLDER (floor generation step 4a): uses only the shared rooms until its own rooms are built (plan step 5). Its enemies and boss are stand-ins; its boss floors are off (boss_floors) until it has its own boss."
tags = PackedStringArray("botany", "placeholder")
room_ids = Array[StringName]([&"room_tile_office"])
enemy_spawns = Array[ExtResource("2_weighted")]([SubResource("Enemy_fly"), SubResource("Enemy_rat")])
boss_id = &"boss_giant_rat"
loot_id = &"loot_zoology_small"
stock_id = &"stock_zoology_vending"
upgrade_type = &"mutation"
ambient_color = Color(0.85, 0.9, 0.85, 1)
accent_color = Color(0.3, 0.8, 0.4, 1)
boss_floors = false
lighting = SubResource("Lighting")
hazard_kinds = PackedStringArray("toxic_spores", "toxic_gas", "water")
