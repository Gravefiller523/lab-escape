part_categories = PackedStringArray("mechanical", "electronic")

[sub_resource type="Resource" id="Type_server_room"]
script = ExtResource("3_room_type")
id = &"room_type_server_room"
room_kind = &"server_room"
display_name = "Server Room"
max_per_floor = 1
size_categories = PackedStringArray("medium")
part_categories = PackedStringArray("electronic", "electrical")

[sub_resource type="Resource" id="Type_machine_shop"]
script = ExtResource("3_room_type")
id = &"room_type_machine_shop"
room_kind = &"machine_shop"
display_name = "Machine Shop"
weight = 1.5
