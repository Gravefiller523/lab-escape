[resource]
script = ExtResource("1_data")
id = &"department_zoology"
display_name = "Zoology"
description = "Animal holding, vet surgery, tanks. PLACEHOLDER (floor generation step 4a): uses only the shared rooms until its own rooms are built (plan step 5). Its boss is the giant rat."
tags = PackedStringArray("zoology", "placeholder")
room_ids = Array[StringName]([&"room_tile_office"])
enemy_spawns = Array[ExtResource("2_weighted")]([SubResource("Enemy_rat"), SubResource("Enemy_bat"), SubResource("Enemy_fly"), SubResource("Enemy_kangaroo")])
boss_id = &"boss_giant_rat"
loot_id = &"loot_zoology_small"
stock_id = &"stock_zoology_vending"
upgrade_type = &"mutation"
