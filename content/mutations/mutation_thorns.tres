[resource]
script = ExtResource("1_data")
id = &"mutation_thorns"
display_name = "Thorns"
description = "Thorny skin. Anything that bites or claws you up close gets pricked back."
tags = PackedStringArray("botany")
effects = Array[ExtResource("2_base")]([SubResource("Rule"), SubResource("Look")])
